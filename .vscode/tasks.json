{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build and Run ASM COM",
      "type": "shell",
     "command": "nasm -f bin \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.com\" && \"${fileDirname}\\${fileBasenameNoExtension}.com\"",
      "options": {
        "shell": {
          "executable": "C:\\Windows\\System32\\cmd.exe",
          "args": ["/c"]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
